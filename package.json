{
  "name": "bare-hid",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm run build && tsx index.js",
    "dev": "npm run build && tsx watch index.js",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:hardware": "npm run test:hardware --workspaces --if-present"
  },
  "keywords": [
    "bare",
    "hid"
  ],
  "author": "Tu Phan <tu.phan@tether.io>",
  "license": "MIT",
  "files": [
    "index.js"
  ],
  "dependencies": {
    "@ledgerhq/device-management-kit": "^1.8.0",
    "@ledgerhq/device-signer-kit-ethereum": "^1.16.0",
    "@tetherto/device-transport-kit-node-hid": "*",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/w3c-web-hid": "^1.0.7",
    "bare": "^1.31.2",
    "bare-node-events": "^1.0.1",
    "bare-node-util": "^1.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "bare": "$bare",
    "bare-runtime": "1.31.0"
  },
  "imports": {
    "~/*": "./node_modules/*"
  }
}
